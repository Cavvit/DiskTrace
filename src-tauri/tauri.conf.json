{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskTrace",
  "version": "0.1.0",
  "identifier": "com.cavit.disktrace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DiskTrace",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 660,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0B0D10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
